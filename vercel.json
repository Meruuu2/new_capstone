{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ua-facility-management-system": {
      "root": ".",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "ua-facility-management-system"
      }
    }
  ]
}
